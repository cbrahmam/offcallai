# OffCall AI - backend configuration
#
# Copy to .env and fill in. Only the "Required" block must be set; everything
# else has a working default or disables an optional feature when left blank.
#
#   cp backend/.env.example backend/.env

# =============================================================================
# Required
# =============================================================================

# PostgreSQL. Use the postgresql+asyncpg:// driver for the app.
# The docker-compose service name is "postgres"; use localhost for a local install.
DATABASE_URL=postgresql+asyncpg://offcall:offcall@localhost:5432/offcall_ai

# Generate each of these with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ENCRYPTION_KEY=

# =============================================================================
# Core services
# =============================================================================

REDIS_URL=redis://localhost:6379

# Public URLs of this deployment. Links in Slack messages and emails, the
# agent install snippet and OAuth redirects are all built from these.
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

ENVIRONMENT=development
DEBUG=true

# Comma-separated, or a JSON list.
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# ClickHouse - required for metrics, logs, traces, RUM and profiling
# =============================================================================
# The rest of the product (incidents, alerts, on-call, runbooks, status pages)
# works without it. docker-compose starts ClickHouse and sets these for you.

CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=offcall
CLICKHOUSE_USE_SSL=false

# =============================================================================
# Authentication
# =============================================================================

ACCESS_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_EXPIRE_DAYS=30
ENABLE_MFA=true
ENABLE_RATE_LIMITING=true
LOGIN_RATE_LIMIT=5

# Emails allowed to reach /api/v1/admin/*. Comma-separated. The admin endpoints
# return 503 until this is set.
SUPER_ADMIN_EMAILS=

# =============================================================================
# Email (optional) - needed for incident notifications and password resets
# =============================================================================
# SMTP takes precedence when both are configured.

FROM_EMAIL=offcall@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Alternative to SMTP
AZURE_COMMUNICATION_CONNECTION_STRING=

# =============================================================================
# AI providers (optional) - power root-cause analysis and the incident chat
# =============================================================================
# Organizations can also add their own keys in Settings; these are the
# deployment-wide fallbacks. Configure two or more to get consensus analysis.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# =============================================================================
# Slack (optional)
# =============================================================================
# Bot token and signing secret drive notifications and slash commands.
# Client id/secret are only needed for the "Add to Slack" OAuth install flow.

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# =============================================================================
# Inbound webhooks (optional)
# =============================================================================
# Shared secret used to verify signatures on incoming alert webhooks.
# Set this in production.
WEBHOOK_SECRET=

# =============================================================================
# External monitoring sources (optional)
# =============================================================================
# Used to enrich alerts by pulling context from tools you already run.

PROMETHEUS_URL=
GRAFANA_URL=
GRAFANA_API_KEY=
DATADOG_API_KEY=
DATADOG_APP_KEY=
NEW_RELIC_API_KEY=
NEW_RELIC_ACCOUNT_ID=

# =============================================================================
# Self-instrumentation (optional)
# =============================================================================
# Trace this backend with OffCall's own Python SDK: pip install ./sdk/python
OFFCALL_APM_API_KEY=
OFFCALL_TRACES_SAMPLE_RATE=0.5

# Send backend errors to a Sentry-compatible endpoint.
SENTRY_DSN=
