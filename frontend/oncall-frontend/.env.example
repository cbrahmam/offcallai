# OffCall AI - frontend build configuration
#
#   cp frontend/oncall-frontend/.env.example frontend/oncall-frontend/.env
#
# These are read at BUILD time by Create React App, not at runtime. Rebuild
# after changing them.

# Base URL of the backend API, including the /api/v1 prefix.
REACT_APP_API_URL=http://localhost:8000/api/v1

# Optional: send this UI's own browser telemetry to your OffCall install.
# Create a key under Browser RUM, or POST /api/v1/rum/applications.
REACT_APP_RUM_API_KEY=

# Set when serving the app from a sub-path (e.g. /offcall).
PUBLIC_URL=/

GENERATE_SOURCEMAP=false
