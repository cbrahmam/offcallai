# ---------------------------------------------------------------------------
# Secrets — never commit. Only *.example files are allowed through.
# ---------------------------------------------------------------------------
.env
.env.*
*.env
!.env.example
!*.env.example
!.env.*.example

*secret*.yaml
*secrets*.yaml
# ...but the committed templates must come through.
!*secret*.example.yaml
!*secrets*.example.yaml
current-secrets.yaml
secret-backup.yaml
k8s-secrets.yaml

*.pem
*.key
!**/testdata/**/*.key
*.p12
*.keystore
*.jks
credentials.json
service-account*.json

# Database dumps
*.sql.gz
*.dump
*backup*.sql
oncall_ai_backup*.sql

